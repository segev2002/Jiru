# Copy to .env and fill in. .env is git-ignored — never commit it.
# Groq key, from https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=medium
# Let Jiru search the web for current info (Groq gpt-oss models only)
LLM_WEB_SEARCH=true

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=chatgpt_clone

# The React dev server, allowed by CORS.
FRONTEND_ORIGIN=http://localhost:5173
