{
  "info": {
    "name": "Jiru API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order: Create conversation saves its id, the next requests use it."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "conversationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      }
    },
    {
      "name": "Create conversation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/conversations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "conversations"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('conversationId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Send message",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/conversations/{{conversationId}}/messages",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "conversations",
            "{{conversationId}}",
            "messages"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"Tell me a one-liner programming joke\"\n}"
        }
      }
    },
    {
      "name": "Send follow-up (same context)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/conversations/{{conversationId}}/messages",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "conversations",
            "{{conversationId}}",
            "messages"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"still one-liner, but change the subject\"\n}"
        }
      }
    },
    {
      "name": "Send message \u2014 think harder",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/conversations/{{conversationId}}/messages",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "conversations",
            "{{conversationId}}",
            "messages"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"How many r's are in 'strawberry'?\",\n  \"think_harder\": true\n}"
        }
      }
    },
    {
      "name": "Send message \u2014 streamed (NDJSON)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/conversations/{{conversationId}}/messages/stream",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "conversations",
            "{{conversationId}}",
            "messages",
            "stream"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"Explain REST in two sentences\",\n  \"think_harder\": false\n}"
        }
      }
    },
    {
      "name": "Get messages",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/conversations/{{conversationId}}/messages",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "conversations",
            "{{conversationId}}",
            "messages"
          ]
        }
      }
    },
    {
      "name": "Get conversation",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/conversations/{{conversationId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "conversations",
            "{{conversationId}}"
          ]
        }
      }
    },
    {
      "name": "List conversations",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/conversations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "conversations"
          ]
        }
      }
    },
    {
      "name": "Delete conversation",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/conversations/{{conversationId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "conversations",
            "{{conversationId}}"
          ]
        }
      }
    }
  ]
}